# Copy to .env (git-ignored) for `docker compose --profile app up`. Never commit real credentials.

# The API's own SQL Server login (CONNECT, VIEW DEFINITION, IMPERSONATE on agent_reader — see docs/setup.md).
# host.docker.internal reaches SQL Server on the Docker host.
AGENT_SQL_CONNECTION=Server=host.docker.internal,1433;Database=FoundryTrade;User ID=agent_api;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=True;Application Name=AiDatabaseAgent

# Optional: audit log (INSERT on AgentOps.audit.QueryLog). Leave empty to disable.
AGENT_AUDIT_CONNECTION=Server=host.docker.internal,1433;Database=AgentOps;User ID=agent_api;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=True;Application Name=AiDatabaseAgent.Audit

# Optional overrides.
# OLLAMA_ENDPOINT=http://host.docker.internal:11434
# OTEL_EXPORTER_OTLP_ENDPOINT=http://dashboard:18889

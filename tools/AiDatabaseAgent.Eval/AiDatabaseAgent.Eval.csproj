<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Console tool: types are internal, which the analyzers are happy with. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AiDatabaseAgent.Core\AiDatabaseAgent.Core.csproj" />
    <ProjectReference Include="..\..\src\AiDatabaseAgent.Infrastructure\AiDatabaseAgent.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
  </ItemGroup>

  <!-- Evaluate the agent exactly as the API is configured: same prompt notes, examples and limits. -->
  <ItemGroup>
    <None Include="..\..\src\AiDatabaseAgent.Api\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\AiDatabaseAgent.Api\appsettings.Development.json" Link="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- V4 business knowledge (single source of truth: /knowledge at the repository root). -->
  <ItemGroup>
    <None Include="..\..\knowledge\*.json" Link="knowledge\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
